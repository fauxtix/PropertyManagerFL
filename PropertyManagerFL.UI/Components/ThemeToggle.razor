@inject IJSRuntime JS
@inject IStringLocalizer<App> Loc

@{
    var actionLabel = _isDark ? Loc["LblThemeLight"] : Loc["LblThemeDark"];
}

<button type="button" class="theme-toggle-btn" @onclick="ToggleTheme"
        title="@actionLabel" aria-label="@actionLabel">
    @if (_isDark)
    {
        <i class="fas fa-sun" aria-hidden="true"></i>
    }
    else
    {
        <i class="fas fa-moon" aria-hidden="true"></i>
    }
</button>

@code {
    // O tema padrão é Dark; o script inline em _Layout.cshtml já o aplicou no cliente.
    private bool _isDark = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var theme = await JS.InvokeAsync<string>("getCurrentTheme");
            var isDark = theme != "light";
            if (isDark != _isDark)
            {
                _isDark = isDark;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            // JS interop indisponível: mantemos o tema padrão aplicado no <head>.
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var theme = await JS.InvokeAsync<string>("toggleTheme");
            _isDark = theme != "light";
        }
        catch (JSException)
        {
            // Não altera o estado local se o tema não pôde ser alternado.
        }
    }
}

<style>
    .theme-toggle-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 32px;
        border: 1px solid var(--app-border);
        border-radius: 6px;
        background: transparent;
        color: var(--app-text-primary);
        font-size: 1.1rem;
        cursor: pointer;
        transition: background 0.2s, color 0.2s, border-color 0.2s;
    }

        .theme-toggle-btn:hover {
            background-color: var(--app-surface-hover);
            color: var(--app-accent-yellow);
            border-color: var(--app-accent-yellow);
        }
</style>
