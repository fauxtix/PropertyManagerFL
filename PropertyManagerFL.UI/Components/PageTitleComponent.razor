<div class="mt-0">
    <div>
        <div class="module-title">
            <div class="title">
                @PageTitle
                @if (WithBadge)
                {
                    <span class="@CssBadgeSubTitle">@PageSubTitle</span>
                    <div class="underline mt-2"></div>
                }
                else
                {
                    <div class="underline"></div>
                }
            </div>
        </div>
    </div>
</div>
<hr />

@code {
    [Parameter] public string PageTitle { get; set; } = "";
    [Parameter] public string PageSubTitle { get; set; } = "";
    [Parameter] public string Css { get; set; } = "planner-patient-wrapper";
    [Parameter] public bool WithBadge { get; set; } = false;

    private string CssBadgeSubTitle { get; set; } = "pb-4 e-badge e-badge-success e-badge-pill size_2";
}

<style>
    .card-box-title {
        -webkit-border-radius: 5px;
        border-radius: 10px;
        -moz-border-radius: 5px;
        background-clip: padding-box;
        margin-bottom: 5px;
        background-color: var(--app-surface);
        box-shadow: var(--app-shadow);
    }

        .card-box-title span {
            padding: 8px;
            margin-left: 10px;
            font-size: 16px;
        }

    .e-badge.blue {
        background: var(--app-primary);
        color: var(--app-on-primary);
    }

    .e-badge.size_1 {
        font-size: 12px;
        margin-top: 4px;
        margin-left: 4px;
    }

    .e-badge.size_2 {
        font-size: 16px;
        margin-top: 4px;
        margin-left: 14px;
    }

    .e-badge.size_3 {
        font-size: 18px;
    }

    .module-title {
        padding: 2px;
        margin: 0px 2px 5px 3px;
    }

    /* Estilos base que antes vinham de AppStyles.css através de header;
       o componente de referência usa div, por isso são replicados aqui. */
    .module-title .title {
        font-weight: bold;
        font-size: 18px;
        color: var(--app-text-primary);
        letter-spacing: 0.54px;
        padding-bottom: 10px;
    }

    .module-title .underline {
        background: var(--app-primary);
        border-radius: 10px;
        width: 100px;
        height: 6px;
    }

    [data-theme="dark"] .title,
    [data-theme="dark"] .module-title .title {
        color: var(--app-text-primary);
    }

    [data-theme="dark"] .card-box-title {
        background-color: var(--app-surface-alt);
    }

    [data-theme="dark"] hr {
        border-color: var(--app-border);
    }
</style>
