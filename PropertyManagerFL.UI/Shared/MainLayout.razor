@using PropertyManagerFL.UI.Pages.Notifications
@inherits LayoutComponentBase
@inject IStringLocalizer<App> L

<PageTitle>PropertyManagerFL.UI</PageTitle>

<div class="layout has-sidebar fixed-sidebar fixed-header" @onkeydown="HandleKeyDown">
    <AuthorizeView>
        <Authorized>
            <SidebarComponent @ref="sideBarComponent" />
        </Authorized>
    </AuthorizeView>

    @* Irmão do <aside>: o selector ".sidebar.toggled ~ .overlay" funciona sem hack. *@
    <div class="overlay" @onclick="CloseSidebar" aria-hidden="true"></div>

    <div class="main">
        @* "auth" é necessário: site.css esconde .top-row:not(.auth) em ecrãs pequenos. *@
        <div class="top-navbar top-row auth">
            <div class="top-navbar-start">
                <AuthorizeView>
                    <Authorized>
                        <button type="button" class="sidebar-toggler break-point-md"
                                @onclick="ToggleSidebar"
                                aria-label="@L["SidebarOpen"]" title="@L["SidebarNavLabel"]">
                            <i class="fa fa-bars" aria-hidden="true"></i>
                        </button>
                    </Authorized>
                </AuthorizeView>
                <a class="navbar-brand" href="">Property Manager</a>
            </div>

            <div class="top-navbar-end">
                <div class="notification-wrapper">
                    <button class="nav-link btn btn-link text-white position-relative"
                            @onclick="ToggleNotificationPopup"
                            id="notificationButton"
                            title="@L["TituloNotificacoes"]" aria-label="@L["TituloNotificacoes"]">
                        <i class="oi oi-bell" style="color: var(--app-danger-text); block-size:stretch"></i>
                        <span class="notification-badge position-absolute top-100 start-100 translate-middle badge rounded-pill bg-warning">
                            @if (!ShowNotificationPopup)
                            {
                                @NotificationCount
                            }
                        </span>
                    </button>
                    @if (ShowNotificationPopup)
                    {
                        <div class="centered-div">
                            <NotificationPopup showPopup="@ShowNotificationPopup" Alerts="CheckForAlerts" />
                        </div>
                    }
                </div>

                <div class="culture-switcher">
                    <CultureSwitcher />
                </div>

                <LoginDisplay />
            </div>
        </div>

        <main class="content" @onclick="CloseSubmenus">
            <article class="page-content px-4 mb-4">
                @Body
            </article>
        </main>
    </div>
</div>

@code {
    private SidebarComponent? sideBarComponent;

    private int NotificationCount;

    private bool ShowNotificationPopup { get; set; } = true;

    private void ToggleSidebar() => sideBarComponent?.BtnToggleClicked();

    private void CloseSidebar() => sideBarComponent?.MouseClickedInOverlay();

    private void CloseSubmenus() => sideBarComponent?.MouseClickedInContent();

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseSidebar();
        }
    }

    private void ToggleNotificationPopup()
    {
        ShowNotificationPopup = !ShowNotificationPopup;
    }

    private void CheckForAlerts(int numberAlerts)
    {
        NotificationCount = numberAlerts;
        StateHasChanged();
    }
}
