@inject IStringLocalizer<App> L

<AuthorizeView>
    <Authorized>
        <a class="topbar-user" href="/Identity/Account/Manage"
           title="@L["TopBarManageAccount"]" aria-label="@L["TopBarManageAccount"]">
            <i class="fa fa-user" aria-hidden="true"></i>
            <span>@context.User.Identity?.Name</span>
        </a>
        <ThemeToggle />
        <form method="post" action="Identity/Account/LogOut" class="m-0">
            <button type="submit" class="topbar-action" title="@L["TopBarLogout"]" aria-label="@L["TopBarLogout"]">
                <i class="fa fa-sign-out" aria-hidden="true"></i>
                <span>@L["TopBarLogout"]</span>
            </button>
        </form>
    </Authorized>
    <NotAuthorized>
        <a class="topbar-action" href="Identity/Account/Register">@L["AuthRegister"]</a>
        <a class="topbar-action" href="Identity/Account/Login">@L["AuthLogin"]</a>
    </NotAuthorized>
</AuthorizeView>
