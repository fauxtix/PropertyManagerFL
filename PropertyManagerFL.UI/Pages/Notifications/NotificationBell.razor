@using Microsoft.AspNetCore.Components.Authorization
@using PropertyManagerFL.Application.Interfaces.Services.AppManager
@using PropertyManagerFL.Application.ViewModels.Notifications
@using PropertyManagerFL.UI.Services
@using System.Security.Claims
@inject INotificationService Notifications
@inject NotificationClientService NotificationClient
@inject NavigationManager Navigation
@inject IStringLocalizer<App> L
@inject ILogger<NotificationBell> Logger
@inject INotificationTextFormatter Formatter

<div class="notification-shell" @onkeydown="HandleKeyDown">
    @if (ShowPanel)
    {
        @* Light dismiss: o primeiro clique fora fecha o painel sem ativar o controlo por baixo. *@
        <div class="notification-dismiss-overlay" @onclick="ClosePanel" aria-hidden="true"></div>
    }

    <button type="button"
            class="notification-trigger"
            id="notificationButton"
            title="@L["TituloNotificacoes"]"
            aria-label="@L["TituloNotificacoes"]"
            aria-expanded="@ShowPanel.ToString().ToLowerInvariant()"
            @onclick="TogglePanelAsync">
        <i class="oi oi-bell" aria-hidden="true"></i>
        @if (BadgeCount > 0)
        {
            <span class="e-badge e-badge-danger e-badge-pill notification-count" aria-hidden="true">
                @(BadgeCount > 9 ? "9+" : BadgeCount.ToString())
            </span>
        }
    </button>

    @if (ShowPanel)
    {
        <div class="notification-panel" role="dialog" aria-label="@L["TituloNotificacoes"]">
            <div class="notification-panel-header">
                <span class="notification-panel-title">@L["TituloNotificacoes"]</span>
                <span class="notification-header-actions">
                    <button type="button" class="notification-expand"
                            title="@L["NotificationsOpenFull"]" aria-label="@L["NotificationsOpenFull"]"
                            @onclick="OpenFullPageAsync">
                        <i class="fa fa-external-link" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="notification-close" title="@L["Close"]" @onclick="ClosePanel">×</button>
                </span>
            </div>

            <SfTab @bind-SelectedItem="SelectedTab" CssClass="notification-tabs">
                <TabItems>
                    <TabItem>
                        <ChildContent><TabHeader Text="@L["NotificationsAll"]"></TabHeader></ChildContent>
                        <ContentTemplate>
                            @if (!VisibleItems.Any())
                            {
                                <SfMessage Severity="MessageSeverity.Info">@L["NotificationsEmpty"]</SfMessage>
                            }
                            else
                            {
                                <div class="notification-list e-list e-list-template">
                                    @foreach (var item in VisibleItems)
                                    {
                                        <div class="e-list-wrapper notification-item @(item.IsCompleted ? "notification-item-completed" : "notification-item-unread")"
                                             @onclick="() => OpenItemAsync(item)">
                                            <span class="notification-item-icon notification-severity-@item.Severity.ToLowerInvariant()">
                                                <i class="fa @IconFor(item.Kind)" aria-hidden="true"></i>
                                            </span>
                                            <div class="e-list-content notification-item-body">
                                                <span class="notification-item-title">@Formatter.Title(item)</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Body))
                                                {
                                                    <span class="notification-item-text">@Formatter.Body(item)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.SuggestedAction))
                                                {
                                                    <span class="notification-item-suggestion">
                                                        <i class="fa fa-lightbulb" aria-hidden="true"></i>
                                                        @L["NotificationsSuggestedAction"] @Formatter.SuggestedAction(item)
                                                    </span>
                                                }
                                                <span class="notification-item-time">@Formatter.RelativeTime(item.CreatedAt)</span>
                                            </div>
                                            @if (item.IsCompleted)
                                            {
                                                <span class="notification-completed-label" title="@L["NotificationsCompleted"]">
                                                    <i class="fa fa-check" aria-hidden="true"></i>
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="notification-unread-dot" aria-label="@L["NotificationsPending"]"></span>
                                            }
                                            <button type="button"
                                                    class="notification-toggle"
                                                    title="@(item.IsCompleted ? L["NotificationsReopen"] : L["NotificationsComplete"])"
                                                    aria-label="@(item.IsCompleted ? L["NotificationsReopen"] : L["NotificationsComplete"])"
                                                    @onclick="() => ToggleCompleteAsync(item)"
                                                    @onclick:stopPropagation="true">
                                                <i class="fa @(item.IsCompleted ? "fa-undo" : "fa-square-check")" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent><TabHeader Text="@L["NotificationsPending"]"></TabHeader></ChildContent>
                        <ContentTemplate>
                            @if (!PendingItems.Any())
                            {
                                <SfMessage Severity="MessageSeverity.Info">@L["NotificationsEmpty"]</SfMessage>
                            }
                            else
                            {
                                <div class="notification-list e-list e-list-template">
                                    @foreach (var item in PendingItems)
                                    {
                                        <div class="e-list-wrapper notification-item notification-item-unread"
                                             @onclick="() => OpenItemAsync(item)">
                                            <span class="notification-item-icon notification-severity-@item.Severity.ToLowerInvariant()">
                                                <i class="fa @IconFor(item.Kind)" aria-hidden="true"></i>
                                            </span>
                                            <div class="e-list-content notification-item-body">
                                                <span class="notification-item-title">@Formatter.Title(item)</span>
                                                @if (!string.IsNullOrWhiteSpace(item.Body))
                                                {
                                                    <span class="notification-item-text">@Formatter.Body(item)</span>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(item.SuggestedAction))
                                                {
                                                    <span class="notification-item-suggestion">
                                                        <i class="fa fa-lightbulb" aria-hidden="true"></i>
                                                        @L["NotificationsSuggestedAction"] @Formatter.SuggestedAction(item)
                                                    </span>
                                                }
                                                <span class="notification-item-time">@Formatter.RelativeTime(item.CreatedAt)</span>
                                            </div>
                                            <span class="notification-unread-dot" aria-label="@L["NotificationsPending"]"></span>
                                            <button type="button"
                                                    class="notification-toggle"
                                                    title="@L["NotificationsComplete"]"
                                                    aria-label="@L["NotificationsComplete"]"
                                                    @onclick="() => ToggleCompleteAsync(item)"
                                                    @onclick:stopPropagation="true">
                                                <i class="fa fa-square-check" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </ContentTemplate>
                    </TabItem>
                </TabItems>
            </SfTab>

            <div class="notification-panel-footer">
                <SfButton CssClass="e-small e-flat" Disabled="@(PendingCount == 0)" OnClick="OpenMarkAllDialog">
                    @L["NotificationsMarkAllComplete"]
                </SfButton>
            </div>
        </div>
    }
</div>

<SfToast @ref="ToastObj" CssClass="e-toast-success" Title="@ToastTitle" Content="@ToastMessage"></SfToast>

<SfDialog @bind-Visible="ConfirmAllDialogVisible" Width="420px" IsModal="true"
          CloseOnEscape="true" ShowCloseIcon="true"
          Header="@L["NotificationsMarkAllComplete"]">
    <DialogTemplates>
        <Content>
            <p class="notification-dialog-message">@L["NotificationsConfirmMarkAllComplete"]</p>
        </Content>
        <FooterTemplate>
            <div class="notification-dialog-actions">
                <SfButton CssClass="e-small e-flat" OnClick="CancelMarkAll">@L["Cancelar"]</SfButton>
                <SfButton CssClass="e-small e-primary" OnClick="ConfirmMarkAllAsync">@L["NotificationsMarkAllComplete"]</SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>
