@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Mvc.ViewEngines
@inject IWebHostEnvironment Environment
@inject ICompositeViewEngine Engine
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Property Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    <link rel="stylesheet" href="~/Identity/css/site.css" />

    @* Mesmo arranque de tema da aplicação Blazor: lê localStorage e ativa os CSS certos antes da primeira pintura. *@
    <link id="sfThemeLight" href="/_content/Syncfusion.Blazor.Themes/bootstrap5.css" rel="stylesheet" disabled />
    <link id="sfThemeDark" href="/_content/Syncfusion.Blazor.Themes/bootstrap5-dark.css" rel="stylesheet" />
    <script>
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme'); } catch (e) { }
            var dark = stored !== 'light';
            document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
            var light = document.getElementById('sfThemeLight');
            var darkLink = document.getElementById('sfThemeDark');
            if (light) { light.disabled = dark; }
            if (darkLink) { darkLink.disabled = !dark; }
        })();
    </script>
    <link rel="stylesheet" href="/css/theme-tokens.css" />
</head>
<body>
