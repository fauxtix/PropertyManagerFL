@page "/admin/appsettings"
@using PropertyManagerFL.Application.Interfaces.Services.Common
@using PropertyManagerFL.Application.ViewModels.AppSettings
@using PropertyManagerFL.Core.Entities
@using PropertyManagerFL.UI.Pages.Arrendamentos
@using PropertyManagerFL.UI.Pages.Proprietario
@using PropertyManagerFL.UI.Pages.Simuladores
@using PropertyManagerFL.UI.Pages.LetterTemplates

<PageTitle>@L["menu-admin-main"]</PageTitle>
<PageTitleComponent PageTitle="@L["menu-admin-main"]"></PageTitleComponent>

@if (settings is null)
{
    <LoadingData />
}
else
{
    <SfBreadcrumb>
        <BreadcrumbItems>
            <BreadcrumbItem Text="@L["TituloInicio"]" IconCss="e-icons e-home" Url="/" />
            <BreadcrumbItem Text="@L["TituloDefinicoes"]" Url="/admin/appsettings" />
        </BreadcrumbItems>
    </SfBreadcrumb>
    <hr />

    <div class="container-fluid settings-shell px-0">
        <EditForm Model="@settings">
            <div class="row g-0">
                <div class="col-lg-2 col-md-3 col-sm-12 pe-md-3">
                    <aside class="settings-sidebar" aria-label="@L["TituloDefinicoes"]">
                        @foreach (var group in SettingsGroups)
                        {
                            var isExpanded = ExpandedGroups.Contains(group.Id);
                            <div class="settings-group">
                                <button type="button"
                                        class="settings-group-header @(isExpanded ? "expanded" : "")"
                                        aria-expanded="@isExpanded"
                                        @onclick="(() => ToggleGroup(group.Id))">
                                    <i class="fa @group.Icon settings-group-icon" aria-hidden="true"></i>
                                    <span class="settings-group-title">@L[group.ResxKey]</span>
                                    <i class="fa fa-chevron-down settings-group-chevron" aria-hidden="true"></i>
                                </button>
                                @if (isExpanded)
                                {
                                    <div class="settings-group-items">
                                        @foreach (var leaf in group.Leaves)
                                        {
                                            <button type="button"
                                                    class="settings-item @(SelectedNode == leaf.Id ? "active" : "")"
                                                    aria-current="@(SelectedNode == leaf.Id ? "true" : null)"
                                                    @onclick="(() => SelectNode(leaf.Id))">
                                                <i class="fa @leaf.Icon settings-item-icon" aria-hidden="true"></i>
                                                <span class="settings-item-label">@L[leaf.ResxKey]</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </aside>
                </div>

                <div class="col-lg-10 col-md-9 col-sm-12 ps-md-3">
                    <div class="settings-content">
                        <div class="card-box settings-card">
                            <h6 class="settings-card-title">@L[SelectedLeafTitle]</h6>

                            @switch (SelectedNode)
                            {
                                case "geral":
                                    <div class="row" id="msg-custom-section">
                                        <div class="col-md-6 my-2">
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoContratoEmAnos" Placeholder="@L["TituloPrazoContratoAnos"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoEnvioCartaAtraso" Placeholder="@L["TituloPrazoEnvioCartaAtraso"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoEnvioCartaAumento" Placeholder="@L["TituloPrazoEnvioCartaAumento"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoEnvioCartaRevogacao" Placeholder="@L["TituloPrazoEnvioCartaRevogacao"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoRespostaCartaAtraso" Placeholder="@L["TituloPrazoRespostaCartaAtraso"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoRespostaCartaAumento" Placeholder="@L["TituloPrazoRespostaCartaAumento"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoRespostaCartaRevogacao" Placeholder="@L["TituloPrazoRespostaCartaRevogacao"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                            </div>
                                            <div class="row mt-3">
                                                <div class="col-md-6">
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PrazoInspecaoGas" Placeholder="@L["TituloPrazoInspecaoGas"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.PercentagemMultaPorAtrasoPagamento" Placeholder="@L["TituloPercentagemMultaPorAtrasoPagamento"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-6 my-2">
                                            <div class="row">
                                                <div class="col-md-9 my-2">
                                                    <div class="mt-2">@L["TituloCartasAumentoAutomaticas"]</div>
                                                    <div class="mt-2">@L["TituloRenovaçãoAutomáticaContrato"]</div>
                                                    <div class="mt-2">@L["TituloComprovativoIRS"]</div>
                                                    <div class="mt-2">@L["TituloComprovativoReciboVencimento"]</div>
                                                    <div class="mt-2">@L["TituloCaucaoRequerida"]</div>
                                                </div>
                                                <div class="col-md-3 my-2">
                                                    <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.CartasAumentoAutomaticas" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch></div>
                                                    <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.RenovacaoAutomatica" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch></div>
                                                    <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.ComprovativoIRS" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch></div>
                                                    <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.ComprovativoReciboVencimento" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch></div>
                                                    <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.CaucaoRequerida" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch></div>
                                                </div>
                                            </div>

                                            <SfTextBox class="form-control" @bind-Value="settings.BackupBaseDados" Placeholder="@L["TituloBackupBD"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                            <SfTextBox class="form-control" @bind-Value="settings.BackupOutrosFicheiros" Placeholder="@L["TituloBackupOutrosFicheiros"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>

                                            <div class="row mt-2">
                                                <div class="col-md-6">
                                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                                               Severity="MessageSeverity.Info" ShowCloseIcon=false ShowIcon=false>@L["TituloDefaultLanguage"]</SfMessage>
                                                    <SfDropDownList TValue="string" CssClass="template"
                                                                    TItem="CountryModel"
                                                                    Placeholder="@L["lblEscolhaLinguagem"]"
                                                                    DataSource="@CountryData" Value="@selectedCulture">
                                                        <DropDownListTemplates TItem="CountryModel">
                                                            <ItemTemplate Context="langCtx">
                                                                <div>
                                                                    <img class="empImage" src="/images/@((langCtx as CountryModel).Pic).png" alt="@L["país"]" />
                                                                    <div class="ename">@L[((langCtx as CountryModel).Text!)]</div>
                                                                </div>
                                                            </ItemTemplate>
                                                            <ValueTemplate Context="ctx">
                                                                <div class="dropdown-width" style="width:100%;height:100%;">
                                                                    <img class="value" src="/images/@((ctx as CountryModel).Pic).png" height="26" width="26" alt="@L["país"]">
                                                                    <div class="name">@L[((ctx as CountryModel).Text!)]</div>
                                                                </div>
                                                            </ValueTemplate>
                                                        </DropDownListTemplates>
                                                        <DropDownListFieldSettings Value="ID" Text="Text"></DropDownListFieldSettings>
                                                        <DropDownListEvents TItem="CountryModel" TValue="string" ValueChange="OnSelected"></DropDownListEvents>
                                                    </SfDropDownList>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                                               Severity="MessageSeverity.Info" ShowCloseIcon=false ShowIcon=false>@L["TituloChaveApi"]</SfMessage>
                                                    <SfTextBox @bind-Value="settings.ApiKey" Placeholder="@L["TituloChaveApi"]"></SfTextBox>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    break;

                                case "proprietario":
                                    <Proprietario />
                                    break;

                                case "coeficientes-rendas":
                                    <RentUpdatingCoefficients />
                                    break;

                                case "coeficientes-imi":
                                    <GestaoCoeficientesIMI />
                                    break;

                                case "modelos":
                                    <LetterTemplates />
                                    break;

                                case "tabelas-apoio":
                                    <ConfigAppTables />
                                    break;

                                case "inicializar-tabelas":
                                    <div class="d-block justify-content-center align-items-md-center my-3">
                                        <hr style="color:var(--app-text-primary)" />
                                        <div>
                                            <h3 class="my-2 text-center">@L["Não esquecer de retirar em Produção!"]</h3>
                                        </div>
                                        <hr style="color:var(--app-text-primary)" />
                                        <div class="d-flex justify-content-center">
                                            <SfButton CssClass="e-btn e-primary e-round-corner p-1" IconCss="fa fa-check" OnClick="InitializeTables">@L["Inicializar tabelas de pagamentos"]</SfButton>
                                        </div>
                                    </div>
                                    <SfMessage Visible="@InitializationMessageVisibility"
                                               CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                               Severity="MessageSeverity.Info" ShowCloseIcon=false ShowIcon=false>@InitializationMessage</SfMessage>
                                    break;

                                case "email":
                                    <div class="row" id="msg-custom-section">
                                        <div class="form-group col-md-6 my-2 card w-50">
                                            <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false>Outlook</SfMessage>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.DisplayName" Placeholder="@L["Display Name"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                    <SfTextBox class="form-control" @bind-Value="settings.Username" Placeholder="@L["lblUtilizador"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.Password" Placeholder="@L["Password"]" Type="InputType.Password" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                    <SfTextBox class="form-control" @bind-Value="settings.Host" Placeholder="@L["Host"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfNumericTextBox class="form-control" @bind-Value="settings.Port" Placeholder="@L["TituloPorta"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group col-md-6 my-2 ml-2 card w-50">
                                            <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false>GMail</SfMessage>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.FromEmail" Placeholder="@L["From"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                    <SfTextBox class="form-control" @bind-Value="settings.SmtpServer" Placeholder="@L["SMTP Server"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.EmailUsername" Placeholder="@L["Username"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                    <SfTextBox class="form-control" @bind-Value="settings.EmailPassword" Placeholder="@L["Password"]" FloatLabelType="FloatLabelType.Always" Type="InputType.Password"></SfTextBox>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <SfNumericTextBox @bind-Value="settings.EmailPort" Placeholder="@L["TituloPorta"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="form-group col-md-6 card w-50 mt-2">
                                            <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false>Hotmail</SfMessage>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.HotmailUsername" Placeholder="@L["Username"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                    <SfTextBox class="form-control" @bind-Value="settings.HotmailPassword" Placeholder="@L["Password"]" FloatLabelType="FloatLabelType.Always" Type="InputType.Password"></SfTextBox>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.HotmailHostname" Placeholder="@L["Hostname"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                    <SfNumericTextBox @bind-Value="settings.HotmailPort" Placeholder="@L["TituloPorta"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="settings-toggle-row">
                                                            <span class="settings-toggle-label">@L["Use Ssl"]</span>
                                                            <SfSwitch @bind-Checked="settings.UseSSL" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group col-md-6 card w-50 mt-2">
                                            <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false>PaperCut</SfMessage>
                                            <div class="row">
                                                <div class="col-md-6">
                                                    <SfTextBox class="form-control" @bind-Value="settings.PaperCutSmtpServer" Placeholder="@L["SMTP Server"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                                </div>
                                                <div class="col-md-6">
                                                    <SfNumericTextBox @bind-Value="settings.PaperCutPort" Placeholder="@L["TituloPorta"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                                </div>
                                                <div class="settings-toggle-row">
                                                    <span class="settings-toggle-label">@L["Enable Ssl"]</span>
                                                    <SfSwitch @bind-Checked="settings.EnableSSL" OnLabel="@L["On"]" OffLabel="@L["Off"]"></SfSwitch>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    break;
                            }
                        </div>

                        @if (HasEditableSettings)
                        {
                            <div class="d-flex justify-content-end align-items-md-center my-3">
                                <SfButton CssClass="e-btn e-primary e-round-corner pl-2 pr-3"
                                          IconCss="fa fa-save"
                                          Content="@L["btnSalvar"]"
                                          OnClick="SaveCurrentSettings">
                                </SfButton>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
}

<SfToast ID="toast_custom" @ref="ToastObj" ShowProgressBar=true
         Title="@ToastTitle" Icon="@ToastIcon"
         Content="@ToastMessage"
         CssClass="@ToastCss" Timeout="2000"
         ShowCloseButton="true">
    <ToastAnimationSettings>
        <ToastShowAnimationSettings Effect="ToastEffect.FadeIn" Duration="600"></ToastShowAnimationSettings>
        <ToastHideAnimationSettings Effect="ToastEffect.FadeOut" Duration="600"></ToastHideAnimationSettings>
    </ToastAnimationSettings>
    <ToastButtons>
        <ToastButton Content="@L["btnFechar"]" OnClick="@HideToast"></ToastButton>
    </ToastButtons>
    <ToastPosition X="Right" Y="Bottom"></ToastPosition>
</SfToast>
