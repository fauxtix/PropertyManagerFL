@page
@model LoginModel

@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using PropertyManagerFL.UI.Shared
@inject IStringLocalizer<PropertyManagerFL.UI.App> localizerApp
@{
    ViewData["Title"] = localizerApp["BtnIngresar"].Value;
}

<div class="login-page">
    <div class="login-card">
        <div class="login-visual">
            <img src="/images/intro-image.jpg" alt="Property Manager FL" />
            <div class="login-visual-overlay">
                <span class="login-visual-mark"><i class="fas fa-building" aria-hidden="true"></i></span>
                <h2>Property Manager FL</h2>
                <p>Gestão de propriedades, inquilinos e documentos.</p>
            </div>
        </div>

        <div class="login-form-side">
            <div class="login-brand">
                <span class="login-brand-icon"><i class="fas fa-cubes" aria-hidden="true"></i></span>
                <span>Property Manager FL</span>
            </div>

            <h1 class="login-title">@localizerApp["BtnIngresar"].Value</h1>
            <p class="login-subtitle">Inicia sessão para continuar.</p>

            <form id="account" method="post" class="login-form">
                <div asp-validation-summary="All" class="login-validation"></div>

                <div class="login-field">
                    <label asp-for="Input.Email" class="login-label">@localizerApp["lblEmail"].Value</label>
                    <div class="login-input-wrap">
                        <i class="fas fa-user login-input-icon" aria-hidden="true"></i>
                        <input asp-for="Input.Email" class="form-control login-input"
                               placeholder="@localizerApp["lblEmail"].Value" required autofocus />
                    </div>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Input.Password" class="login-label">Password</label>
                    <div class="login-input-wrap">
                        <i class="fas fa-key login-input-icon" aria-hidden="true"></i>
                        <input asp-for="Input.Password" class="form-control login-input"
                               placeholder="Password" required />
                    </div>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="login-options">
                    <label class="login-remember">
                        <input asp-for="Input.RememberMe" type="checkbox" checked="checked" />
                        <span>Lembra-te de mim</span>
                    </label>
                    <a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl" class="login-link">Esqueci-me da password</a>
                </div>

                <button type="submit" class="btn btn-primary login-submit">@localizerApp["BtnIngresar"].Value</button>

                <div class="login-footer">
                    <span>Ainda não tens conta?</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="login-link">Registo</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style type="text/css">
    .login-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem 1rem;
        background: var(--app-bg);
        color: var(--app-text-primary);
    }

    .login-card {
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
        width: min(960px, 100%);
        min-height: 540px;
        overflow: hidden;
        border: 1px solid var(--app-border);
        border-radius: 18px;
        background: var(--app-surface);
        box-shadow: 0 18px 50px rgba(15, 23, 42, 0.18);
    }

    .login-visual {
        position: relative;
        min-height: 100%;
        background: var(--app-primary);
    }

        .login-visual img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

    .login-visual-overlay {
        position: absolute;
        inset: auto 0 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        padding: 2rem 1.75rem;
        background: linear-gradient(transparent, rgba(15, 23, 42, 0.88));
        color: #fff;
    }

        .login-visual-overlay h2 {
            margin: 0;
            font-size: 1.35rem;
            font-weight: 700;
        }

        .login-visual-overlay p {
            margin: 0;
            font-size: 0.9rem;
            opacity: 0.9;
        }

    .login-visual-mark {
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        margin-bottom: 0.4rem;
        border-radius: 10px;
        background: var(--app-accent-yellow);
        color: #1f2937;
        font-size: 1.1rem;
    }

    .login-form-side {
        padding: 2.5rem clamp(1.5rem, 4vw, 3rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .login-brand {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.75rem;
        font-weight: 700;
        color: var(--app-text-primary);
    }

    .login-brand-icon {
        display: grid;
        place-items: center;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: var(--app-primary);
        color: var(--app-on-primary);
        font-size: 1.05rem;
    }

    .login-title {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--app-text-primary);
    }

    .login-subtitle {
        margin: 0.25rem 0 1.75rem;
        color: var(--app-text-secondary);
    }

    .login-form {
        width: 100%;
    }

    .login-validation {
        color: var(--app-danger-text);
        font-size: 0.85rem;
    }

        .login-validation:empty {
            display: none;
        }

    .login-field + .login-field {
        margin-top: 1.1rem;
    }

    .login-label {
        display: block;
        margin-bottom: 0.4rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--app-text-secondary);
    }

    .login-input-wrap {
        position: relative;
    }

    .login-input-icon {
        position: absolute;
        top: 50%;
        left: 0.9rem;
        transform: translateY(-50%);
        color: var(--app-text-secondary);
        pointer-events: none;
    }

    .login-input {
        height: 48px;
        padding-left: 2.75rem;
        border: 1px solid var(--app-border);
        border-radius: 10px;
        background: var(--app-surface);
        color: var(--app-text-primary);
    }

        .login-input:focus {
            border-color: var(--app-primary);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

    .login-options {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        margin: 1.1rem 0 1.5rem;
    }

    .login-remember {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        color: var(--app-text-secondary);
        font-size: 0.85rem;
    }

        .login-remember input {
            width: 16px;
            height: 16px;
            margin: 0;
            accent-color: var(--app-primary);
        }

    .login-link {
        color: var(--app-primary);
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
    }

        .login-link:hover {
            color: var(--app-primary-hover);
            text-decoration: underline;
        }

    .login-submit {
        width: 100%;
        height: 48px;
        border: 0;
        border-radius: 10px;
        font-weight: 700;
    }

    .login-footer {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--app-border);
        color: var(--app-text-secondary);
        font-size: 0.85rem;
    }

    @@media (max-width: 767px) {
        .login-card {
            grid-template-columns: 1fr;
        }

        .login-visual {
            min-height: 150px;
        }

        .login-visual-overlay {
            padding: 1rem 1.25rem;
        }

        .login-form-side {
            padding: 1.75rem 1.25rem;
        }
    }
</style>
